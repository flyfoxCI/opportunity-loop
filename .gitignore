loop/runs/
loop/state/
loop/cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# TinyFish CLI artifacts
.tinyfish/

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Don't ignore seed_directions/ or PLAYBOOK.md — they're committed evidence
!loop/seed_directions/

# Radar v2: SQLite is a rebuildable cache; data/snapshots/*.jsonl.gz is what gets committed
data/radar.sqlite*
# v3: App Store / Google Play chart snapshots are MBs/day: CI cache + `data-charts` release, not git
data/charts/
# v5: DuckDB working DB (CI: Actions cache) and the Parquet lake (CI: Cloudflare R2)
data/radar.duckdb*
data/lake/
